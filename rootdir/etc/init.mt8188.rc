import /vendor/etc/init/hw/init.mt8188.usb.rc

on early-init
    # Kernel modules
    setprop vendor.all.modules.ready 0
    start insmod_sh

    # Performance
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "performance"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "performance"

    # Preloader
    write /sys/block/mmcblk0boot0/ro_lock_until_next_power_on 1

on init
    # Cpusets
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/top-app/cpus 0-7

    # Network
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/wmem_max 8388608

on charger
    # Battery
    mkdir /mnt/vendor/nvcfg
    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg rw wait
    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg
    start fuelgauged

    # Performance
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "schedutil"

on fs
    # Partitions
    symlink /dev/block/platform/11230000.mmc /dev/block/platform/bootdevice
    mount_all /vendor/etc/fstab.emmc --early

    # ZRAM
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/kernel/mm/swap/vma_ra_enabled false
    swapon_all /vendor/etc/fstab.enableswap

on late-fs
    # Partitions
    mount_all /vendor/etc/fstab.emmc --late

on post-fs-data
    # Battery
    chown system system /mnt/vendor/nvcfg
    chmod 0771 /mnt/vendor/nvcfg
    restorecon_recursive /mnt/vendor/nvcfg
    chown system system /mnt/vendor/nvcfg/fg
    chown system system /mnt/vendor/nvcfg/fg/car_tune_value
    chown system system /mnt/vendor/nvcfg/fg/old_fg_data

    # Bluetooth
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    start vendor.btmac

    # Camera
    mkdir /data/vendor/camera_dump 0771 root system
    mkdir /data/vendor/flash 0771 root system
    mkdir /data/vendor/flicker 0771 root system
    mkdir /data/vendor/ndd 0771 root system
    mkdir /data/vendor/pdo 0771 root system
    mkdir /data/vendor/shading 0771 root system
    mkdir /data/vendor/shading_otp 0771 root system
    mkdir /mnt/vendor/cct 0771 root system

    # Display
    chmod 0444 /dev/mtk_disp

    # Fingerprint
    mkdir /data/vendor/gf_data 0755 system system

    # Media
    mkdir /data/vendor/vcodec 0770 media system
    mkdir /data/vendor/vcodec/in 0770 media system
    mkdir /data/vendor/vcodec/log 0770 media system
    mkdir /data/vendor/vcodec/out 0770 media system

    # Sensors
    mkdir /data/vendor/sensor 0774 system system

    # Storage
    write /sys/block/dm-0/queue/read_ahead_kb 2048
    write /sys/block/dm-1/queue/read_ahead_kb 2048
    write /sys/block/dm-2/queue/read_ahead_kb 2048
    write /sys/block/dm-3/queue/read_ahead_kb 2048
    write /sys/block/dm-4/queue/read_ahead_kb 2048
    write /sys/block/dm-5/queue/read_ahead_kb 2048
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048

    # Thermal
    mkdir /data/vendor/.tp 0775 system system
    mkdir /data/vendor/thermal 0775 system system

    # Wi-Fi
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # Bluetooth
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules btmtk_sdio_unify.ko

    # Lights
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    # Memory
    write /proc/sys/vm/dirty_writeback_centisecs 300
    write /proc/sys/vm/min_free_kbytes 32768
    write /proc/sys/vm/watermark_boost_factor 0

    # Performance
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_req_ddr_opp 0

    # Wi-Fi
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules wlan_mt7902_sdio.ko

on property:ro.bootmode=charger && property:vendor.all.modules.ready=1
    # Performance
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_req_ddr_opp 0
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_req_ddr_opp 8

on property:sys.boot_completed=1
    # Performance
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0
    write /sys/devices/platform/10012000.dvfsrc/helio-dvfsrc/dvfsrc_req_ddr_opp 8
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor "schedutil"
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 1000
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/rate_limit_us 1000

    # Power
    setprop vendor.powerhal.init 1

    # Storage
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    write /sys/block/dm-2/queue/read_ahead_kb 128
    write /sys/block/dm-3/queue/read_ahead_kb 128
    write /sys/block/dm-4/queue/read_ahead_kb 128
    write /sys/block/dm-5/queue/read_ahead_kb 128
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/read_ahead_kb 128

on property:vendor.all.modules.ready=1
    # Camera
    start camerahalserver

    # Health
    chown system system /proc/mtk_battery_cmd/current_cmd

    # Sensors
    chown system system /sys/class/sensor/m_acc_misc/accactive
    chown system system /sys/class/sensor/m_acc_misc/accbatch
    chown system system /sys/class/sensor/m_acc_misc/acccali
    chown system system /sys/class/sensor/m_acc_misc/accdelay
    chown system system /sys/class/sensor/m_acc_misc/accenablenodata
    chown system system /sys/class/sensor/m_acc_misc/accflush
    chmod 0660 /sys/class/sensor/m_acc_misc/accactive
    chmod 0660 /sys/class/sensor/m_acc_misc/accbatch
    chmod 0660 /sys/class/sensor/m_acc_misc/acccali
    chmod 0660 /sys/class/sensor/m_acc_misc/accdelay
    chmod 0660 /sys/class/sensor/m_acc_misc/accenablenodata
    chmod 0660 /sys/class/sensor/m_acc_misc/accflush

    chown system system /sys/class/sensor/m_als_misc/alsactive
    chown system system /sys/class/sensor/m_als_misc/alsbatch
    chown system system /sys/class/sensor/m_als_misc/alscali
    chown system system /sys/class/sensor/m_als_misc/alsdelay
    chown system system /sys/class/sensor/m_als_misc/alsflush
    chmod 0660 /sys/class/sensor/m_als_misc/alsactive
    chmod 0660 /sys/class/sensor/m_als_misc/alsbatch
    chmod 0660 /sys/class/sensor/m_als_misc/alscali
    chmod 0660 /sys/class/sensor/m_als_misc/alsdelay
    chmod 0660 /sys/class/sensor/m_als_misc/alsflush

    chown system system /sys/class/sensor/m_ps_misc/psactive
    chown system system /sys/class/sensor/m_ps_misc/psbatch
    chown system system /sys/class/sensor/m_ps_misc/pscali
    chown system system /sys/class/sensor/m_ps_misc/psdelay
    chown system system /sys/class/sensor/m_ps_misc/psflush
    chmod 0660 /sys/class/sensor/m_ps_misc/psactive
    chmod 0660 /sys/class/sensor/m_ps_misc/psbatch
    chmod 0660 /sys/class/sensor/m_ps_misc/pscali
    chmod 0660 /sys/class/sensor/m_ps_misc/psdelay
    chmod 0660 /sys/class/sensor/m_ps_misc/psflush

    start vendor.sensors-hal-2-0

service insmod_sh /vendor/bin/init.insmod.sh /vendor/etc/init.insmod.mt8188.cfg
    user root
    group root system
    disabled
    oneshot

service vendor.btmac /vendor/bin/init.btmac.sh
    user bluetooth
    group bluetooth
    disabled
    oneshot

service vendor.sensors-hal-2-0 /vendor/bin/hw/android.hardware.sensors@2.0-service-mediatek
    class main
    user system
    group system
    rlimit rtprio 10 10
    disabled

service watchdogd /system/bin/watchdogd 20 10
    class core
    seclabel u:r:watchdogd:s0
